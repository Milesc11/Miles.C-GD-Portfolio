import GlowLineSeparator from "../components/ui/separator/GlowLineSeparator.astro";
const pageTitle = 'About Me';
const pageDescription = 'Learn more about my background.';
---

<Layout title={pageTitle} description={pageDescription} pubDate={new Date()} showHeader={false}>
  
      <HeroSection title="About Me" subtitle="Learn a little bit more about my background." />
      <GlowLineSeparator />

  <p>
    Hello, I'm Miles Cambridge, a graphic designer as well as a digital artist. Outside designing, my hobbies include drawing and listening to music. 
  </p>
  <p>
    I work with a variety of design programs, including Adobe Illustrator, Adobe Photoshop, Adobe InDesign, Adobe After Effects, Figma, and Affinity. 
    When working on digital illustrations, I use the program Clip Studio Paint.
  </p>
