---
import BaseHead from "/src/components/BaseHead.astro";
import Header from "/src/components/sections/Header.astro";
import Footer from "/src/components/sections/Footer.astro";
import Projects from "/src/components/sections/Projects.astro";
import HeroSection from "/src/components/sections/HeroSection.astro";
import GlowLineSeparator from "/src/components/ui/separator/GlowLineSeparator.astro";
---


<html lang="en" data-theme="dark" class="dark">
  <head>
    <BaseHead title="Project 8: NPSC Presents: Sparx's Sky Strike" description="Project 8" />
  </head>
  <body>
    <Header />
    <main>
      <HeroSection title="NPSC Presents: Sparx's Sky Strike" subtitle="A poster for New Paltz Smash Club’s Event, Sparx’s Sky Strike." />
      <GlowLineSeparator />
      <div class="project-content">
        <div class="hero-images">
      <img src="/project-8-poster.jpg" alt="Project 8 poster">
        </div>
      <p>This design was created for my New Paltz Smash Club event, Sparx’s Sky Strike.
        Both the title and it's design were inspired by the game I chose for the event, Granblue Fantasy Versus Rising.
        I drew the character illustrations based on the games that were going to be featured at the event, as well as them being the characters I use in each game.
      </p>
      </div>
      <GlowLineSeparator />
    </main>
    <Footer />
  </body>
</html>

<style>
.hero-images{
  max-width: max-content;
  display: flex;
  flex-direction:row;
  flex-wrap: wrap;
  }
img {
  display: block;
  margin-left: auto;
  margin-right: auto;
  padding: 2rem 0 3rem 0;
  width: 45%; /* Optional: adjust as needed */
}
</style>
