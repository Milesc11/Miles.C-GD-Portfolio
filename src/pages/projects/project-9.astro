---
import BaseHead from "/src/components/BaseHead.astro";
import Header from "/src/components/sections/Header.astro";
import Footer from "/src/components/sections/Footer.astro";
import Projects from "/src/components/sections/Projects.astro";
import HeroSection from "/src/components/sections/HeroSection.astro";
import GlowLineSeparator from "/src/components/ui/separator/GlowLineSeparator.astro";
---


<html lang="en" data-theme="dark" class="dark">
  <head>
    <BaseHead title="Project 9: NPSC Fall 2024 Student Power Rankings" description="Project 9" />
  </head>
  <body>
    <Header />
    <main>
      <HeroSection title="NPSC Fall 2024 Student Power Rankings" subtitle="A graphic for New Paltz Smash Club’s Fall 2024 Student Power Rankings." />
      <GlowLineSeparator />
      <div class="project-content">
        <div class="hero-images">
      <img src="/project-9-graphic.jpg" alt="Project 9 graphic">
        </div>
      <p>This design was created for New Paltz Smash Club’s Fall 2024 Student Power Rankings. The design was inspired by the game, Persona 5, using the color red and polygonal shapes for the main section to recreate one of the game's sequences, resembling broken glass. The section on the right was created based on the menu design of the game, using overlapping star patterns. 
        For the character illustrations, I tried to replicate the art style used in the game’s character portraits, while giving each one a pose that matches their personality.
      </p>
      </div>
      <GlowLineSeparator />
    </main>
    <Footer />
  </body>
</html>

<style>
.hero-images{
  max-width: max-content;
  display: flex;
  flex-direction:row;
  flex-wrap: wrap;
  }
img {
  display: block;
  margin-left: auto;
  margin-right: auto;
  padding: 2rem 0 3rem 0;
  width: 90%; /* Optional: adjust as needed */
}
</style>
