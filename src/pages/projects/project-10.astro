---
import BaseHead from "/src/components/BaseHead.astro";
import Header from "/src/components/sections/Header.astro";
import Footer from "/src/components/sections/Footer.astro";
import Projects from "/src/components/sections/Projects.astro";
import HeroSection from "/src/components/sections/HeroSection.astro";
import GlowLineSeparator from "/src/components/ui/separator/GlowLineSeparator.astro";
---


<html lang="en" data-theme="dark" class="dark">
  <head>
    <BaseHead title="Project 10: NPSC Spring 2025 Power Rankings" description="Project 10" />
  </head>
  <body>
    <Header />
    <main>
      <HeroSection title="NPSC Spring 2025 Power Rankings" subtitle="A graphic for New Paltz Smash Club’s Spring 2025 Power Rankings." />
      <GlowLineSeparator />
      <div class="project-content">
        <div class="hero-images">
      <img src="/project-10-graphic.jpg" alt="Project 10 graphic">
        </div>
      <p>This design was created for New Paltz Smash Club’s Spring 2025 Power Rankings. The design was inspired by wanted poster boards, with wanted posters themselves inspired by the ones in the show, One Piece. 
        For the character illustrations, I gave each one a pose that matches their personality, while maintaining the aesthetic of the poses of the show's wanted poster illuatrations.</p>
      </div>
      <GlowLineSeparator />
    </main>
    <Footer />
  </body>
</html>

<style>
.hero-images{
  max-width: max-content;
  display: flex;
  flex-direction:row;
  flex-wrap: wrap;
  }
img {
  display: block;
  margin-left: auto;
  margin-right: auto;
  padding: 2rem 0 3rem 0;
  width: 75%; /* Optional: adjust as needed */
}
</style>
