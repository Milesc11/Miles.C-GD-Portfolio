---
import BaseHead from "/src/components/BaseHead.astro";
import Header from "/src/components/sections/Header.astro";
import Footer from "/src/components/sections/Footer.astro";
import Projects from "/src/components/sections/Projects.astro";
import HeroSection from "/src/components/sections/HeroSection.astro";
import GlowLineSeparator from "/src/components/ui/separator/GlowLineSeparator.astro";
---


<html lang="en" data-theme="dark" class="dark">
  <head>
    <BaseHead title="Project 11: NPSC Fall 2025 Power Rankings" description="Project 11" />
  </head>
  <body>
    <Header />
    <main>
      <HeroSection title="NPSC Fall 2025 Power Rankings" subtitle="A graphic for New Paltz Smash Club’s Fall 2025 Power Rankings." />
      <GlowLineSeparator />
      <div class="project-content">
        <div class="hero-images">
      <img src="/project-11-graphic.jpg" alt="Project 11 graphic">
        </div>
      <p>This design was created for New Paltz Smash Club’s Fall 2025 Power Rankings. The design was inspired by the album cover, Demon Days, by the band, Gorillaz. 
        For the character illustrations, I replicated the main details of the characters on the album cover, that being the side profile, and the direction they're looking.</p>
      </div>
      <GlowLineSeparator />
    </main>
    <Footer />
  </body>
</html>

<style>
.hero-images{
  max-width: max-content;
  display: flex;
  flex-direction:row;
  flex-wrap: wrap;
  }
img {
  display: block;
  margin-left: auto;
  margin-right: auto;
  padding: 2rem 0 3rem 0;
  width: 90%; /* Optional: adjust as needed */
}
</style>
